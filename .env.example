# Copy to .env and replace empty values. Never commit .env.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Base64 encoding of at least 32 cryptographically random bytes.
JWT_SECRET=
JWT_TTL=PT15M
BACKEND_PORT=8081
# Loopback by default. External access requires an explicitly approved deployment.
BACKEND_BIND_ADDRESS=127.0.0.1
